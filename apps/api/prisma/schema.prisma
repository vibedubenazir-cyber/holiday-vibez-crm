  date         DateTime?           @db.Date
  endDate      DateTime?           @db.Date
  startTime    String?
  endTime      String?
  showTime     Boolean             @default(true)
  description  String?
  photoUrl     String?
  transferType TransportationType?
  netAmount    Decimal?            @db.Decimal(14, 2)
  markupPct    Decimal?            @db.Decimal(5, 2)
  addOns       Json?
  details      Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  pricingOptions ItineraryPricingOption[] @relation("PricingOptionAccommodations")

