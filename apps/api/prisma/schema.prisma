model Invoice {
  id            String      @id @default(uuid())
  bookingId     String
  booking       Booking     @relation(fields: [bookingId], references: [id])
  invoiceNo     String      @unique
  type          InvoiceType
  amount        Decimal     @db.Decimal(14, 2)
  // GST% applied to `amount` — taxAmount is derived from this at creation time
  // unless an explicit taxAmount is passed (e.g. a manually-adjusted invoice).
  gstRate       Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal     @default(0) @db.Decimal(14, 2)
