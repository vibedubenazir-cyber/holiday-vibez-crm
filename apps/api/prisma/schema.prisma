  baseMarkupPct     Decimal              @default(0) @db.Decimal(5, 2)
  extraMarkupAmount Decimal              @default(0) @db.Decimal(14, 2)
  cgstPct           Decimal              @default(0) @db.Decimal(5, 2)
  sgstPct           Decimal              @default(0) @db.Decimal(5, 2)
  igstPct           Decimal              @default(0) @db.Decimal(5, 2)
  tcsPct            Decimal              @default(0) @db.Decimal(5, 2)
  discountAmount    Decimal              @default(0) @db.Decimal(14, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("itinerary_pricing_options")
}

model ItineraryPackageTerms {
