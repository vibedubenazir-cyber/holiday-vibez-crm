// Internal staff communication — separate from the customer-facing Conversation/Message
// pair (which is always tied to a Lead). BRANCH channels are auto-provisioned per branch
// and visible by branchId match (no membership rows needed); ORG_WIDE is a single
// auto-provisioned singleton visible to everyone; GROUP channels are ad-hoc and gated by
// TeamChannelMember rows.
enum TeamChannelType {
  BRANCH
  ORG_WIDE
  GROUP
  DIRECT
}

model TeamChannel {
  id            String          @id @default(uuid())
  name          String
  type          TeamChannelType
  branchId      String?
  branch        Branch?         @relation(fields: [branchId], references: [id])
  createdBy     String
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())

  members  TeamChannelMember[]
  messages TeamMessage[]

  @@map("team_channels")
}

model TeamChannelMember {
  id        String      @id @default(uuid())
  channelId String
  channel   TeamChannel @relation(fields: [channelId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  joinedAt  DateTime    @default(now())

  @@unique([channelId, userId])
  @@map("team_channel_members")
}

model TeamMessage {
  id        String      @id @default(uuid())
  channelId String
  channel   TeamChannel @relation(fields: [channelId], references: [id])
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id])
  body      String?
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  createdAt DateTime    @default(now())

  @@map("team_messages")
}

// Internal staff training (LMS) — Admin/Director author courses (lessons + an optional
// quiz); any staff member enrolls, marks lessons complete, and takes the quiz once all
// lessons are done. A course is "complete" once every lesson is done and (if the course
// has a quiz) the latest attempt passed — that transition auto-issues a Certificate, so
// there's no separate manual "issue certificate" action to forget.
model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons       Lesson[]
  quizQuestions QuizQuestion[]
  enrollments   Enrollment[]
  assignments   CourseAssignment[]

  @@map("lms_courses")
}

model Lesson {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  progress LessonProgress[]

  @@map("lms_lessons")
}

model QuizQuestion {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  text         String
  options      String[]
  correctIndex Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("lms_quiz_questions")
}

model Enrollment {
  id           String    @id @default(uuid())
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  // Set when this enrollment was created (or its due date updated) by a
  // manager assignment rather than self-enrollment — see CourseAssignment.
  // Null means the learner enrolled themselves.
  dueDate      DateTime?
  assignedById String?

  progress    LessonProgress[]
  attempts    QuizAttempt[]
  certificate Certificate?

  @@unique([courseId, userId])
  @@map("lms_enrollments")
}

// Audit record of a manager assigning a course to a scope of learners
// (a single consultant, a whole branch, or every user with a given role).
// Assigning materializes/updates an Enrollment row (with dueDate +
// assignedById) for every user the scope resolves to at assignment time —
// this is a point-in-time snapshot, not a live rule, so someone who joins
// the branch/role afterward won't automatically be covered without a new
// assignment. That mirrors how Target.scope/scopeId already works elsewhere
// in this schema.
enum AssignmentScope {
  CONSULTANT
  BRANCH
  ROLE
}

model CourseAssignment {
  id         String          @id @default(uuid())
  courseId   String
  course     Course          @relation(fields: [courseId], references: [id])
  scope      AssignmentScope
  scopeId    String
  dueDate    DateTime?
  assignedBy String
  assignedAt DateTime        @default(now())
  notes      String?

  @@map("lms_course_assignments")
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
  @@map("lms_lesson_progress")
}

model QuizAttempt {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  score        Int
  passed       Boolean
  attemptedAt  DateTime   @default(now())

  @@map("lms_quiz_attempts")
}

model Certificate {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  courseId     String
  userId       String
  certNo       String     @unique
  issuedAt     DateTime   @default(now())

  @@map("lms_certificates")
}

// Accounts sub-modules (Finance module): petty cash, budgets-vs-actuals, manual
// bank reconciliation, and DMC commission receivables. Daily Ledger and the GST
// report are pure aggregations over existing Payment/Expense/Invoice rows (see
// ReportsService) — no dedicated model needed for those two.

enum PettyCashType {
  CASH_IN
  CASH_OUT
}

model PettyCashEntry {
  id          String        @id @default(uuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  type        PettyCashType
  amount      Decimal       @db.Decimal(14, 2)
  category    String?
  description String
  entryDate   DateTime      @db.Date
  createdBy   String
  createdAt   DateTime      @default(now())

  @@map("petty_cash_entries")
}

// One row per branch+category+month — set once per period, compared against
// the sum of matching Expense rows at read time so it never drifts from actuals.
model Budget {
  id             String          @id @default(uuid())
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  category       ExpenseCategory
  month          Int
  year           Int
  budgetedAmount Decimal         @db.Decimal(14, 2)
  createdBy      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([branchId, category, month, year])
  @@map("budgets")
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

// Staff key in each bank statement line by hand, then match it against an
// existing Payment (1:1 via matchedPaymentId) — no statement file format to
// support, and a matched line can never be double-matched thanks to @unique.
model BankTransaction {
  id               String              @id @default(uuid())
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id])
  transactionDate  DateTime            @db.Date
  description      String
  amount           Decimal             @db.Decimal(14, 2)
  type             BankTransactionType
  matched          Boolean             @default(false)
  matchedPaymentId String?             @unique
  matchedPayment   Payment?            @relation(fields: [matchedPaymentId], references: [id])
  createdBy        String
  createdAt        DateTime            @default(now())

  @@map("bank_transactions")
}

enum CommissionStatus {
  PENDING
  RECEIVED
}

// Money a DMC owes US (e.g. volume-based commission on a booking) — the
// receivable-side counterpart to the existing outbound COMMISSION Payment
// type, which is money we pay out. tdsAmount is what we expect withheld
// under Indian TDS rules when the DMC actually pays out.
model DmcCommission {
  id         String           @id @default(uuid())
  supplierId String
  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  bookingId  String?
  booking    Booking?         @relation(fields: [bookingId], references: [id])
  amount     Decimal          @db.Decimal(14, 2)
  tdsAmount  Decimal          @default(0) @db.Decimal(14, 2)
  status     CommissionStatus @default(PENDING)
  receivedAt DateTime?
  notes      String?
  createdBy  String
  createdAt  DateTime         @default(now())

  @@map("dmc_commissions")
}

// ---------------------------------------------------------------------------
// HRMS phase 3 — holidays, rostering, attendance regularisation, employee
// documents, onboarding, asset tracking and appraisal cycles.
// ---------------------------------------------------------------------------

// Public holidays. branchId null = observed org-wide; set = that branch only
// (Kerala observes Onam, Maharashtra Gudi Padwa). Leave day-counting and
// attendance both consult this so a holiday never burns a leave day.
model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @db.Date
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@unique([date, branchId])
  @@map("holidays")
}

enum RegularisationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A missed or wrong punch. Consultants at airports and site visits forget
// constantly, and without this the day is permanently an unfixable absence.
model AttendanceRegularisation {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation("RegularisationRequests", fields: [userId], references: [id])
  date                DateTime             @db.Date
  requestedCheckInAt  DateTime?
  requestedCheckOutAt DateTime?
  reason              String
  status              RegularisationStatus @default(PENDING)
  reviewedById        String?
  reviewedBy          User?                @relation("RegularisationReviews", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewComment       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([userId, date])
  @@map("attendance_regularisations")
}

model Shift {
  id            String        @id @default(uuid())
  name          String
  startTime     String // "09:00"
  endTime       String // "18:00"
  graceMinutes  Int           @default(10)
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id])
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rosterEntries RosterEntry[]

  @@map("shifts")
}

// One row per employee per day. A null shift with isWeekOff true is the
// weekly off; a null shift with isWeekOff false means "no roster published".
model RosterEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("RosterEntries", fields: [userId], references: [id])
  date      DateTime @db.Date
  shiftId   String?
  shift     Shift?   @relation(fields: [shiftId], references: [id])
  isWeekOff Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("roster_entries")
}

enum EmployeeDocumentType {
  AADHAAR
  PAN
  PASSPORT
  OFFER_LETTER
  CONTRACT
  EDUCATION_CERTIFICATE
  BANK_PROOF
  OTHER
}

// Mirrors the traveler passport/visa expiry tracking already used on the CRM
// side, so staff document expiry gets the same treatment as customers'.
model EmployeeDocument {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation("EmployeeDocuments", fields: [userId], references: [id])
  type         EmployeeDocumentType
  title        String
  fileUrl      String
  number       String?
  issuedOn     DateTime?            @db.Date
  expiresOn    DateTime?            @db.Date
  uploadedById String
  uploadedBy   User                 @relation("EmployeeDocumentsUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime             @default(now())

  @@map("employee_documents")
}

// The joining-side counterpart to ExitRecord's clearance checklist.
model OnboardingTask {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("OnboardingTasks", fields: [userId], references: [id])
  title         String
  description   String?
  dueDate       DateTime? @db.Date
  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("OnboardingTasksCompleted", fields: [completedById], references: [id])
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("onboarding_tasks")
}

enum AssetType {
  LAPTOP
  DESKTOP
  PHONE
  SIM_CARD
  MONITOR
  ACCESS_CARD
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETURNED
  RETIRED
}

// Exit clearance checks this: an employee holding unreturned assets should
// not be cleared, which today nothing enforces.
model Asset {
  id           String      @id @default(uuid())
  assetTag     String      @unique
  type         AssetType
  name         String
  serialNumber String?
  purchaseDate DateTime?   @db.Date
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  status       AssetStatus @default(AVAILABLE)
  assignedToId String?
  assignedTo   User?       @relation("AssetsAssigned", fields: [assignedToId], references: [id])
  assignedAt   DateTime?
  returnedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("assets")
}

enum AppraisalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AppraisalStatus {
  NOT_STARTED
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

model AppraisalCycle {
  id         String               @id @default(uuid())
  name       String
  startDate  DateTime             @db.Date
  endDate    DateTime             @db.Date
  status     AppraisalCycleStatus @default(DRAFT)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  appraisals Appraisal[]

  @@map("appraisal_cycles")
}

// Unlike the existing ad-hoc PerformanceReview, an Appraisal belongs to a
// cycle and walks a self-review -> manager-review -> completed workflow.
model Appraisal {
  id              String          @id @default(uuid())
  cycleId         String
  cycle           AppraisalCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("Appraisals", fields: [userId], references: [id])
  managerId       String?
  manager         User?           @relation("AppraisalsAsManager", fields: [managerId], references: [id])
  status          AppraisalStatus @default(NOT_STARTED)
  selfComments    String?
  managerComments String?
  finalRating     Int?
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  goals           AppraisalGoal[]

  @@unique([cycleId, userId])
  @@map("appraisals")
}

model AppraisalGoal {
  id            String    @id @default(uuid())
  appraisalId   String
  appraisal     Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  title         String
  weightPct     Int       @default(0)
  selfRating    Int?
  managerRating Int?
  comments      String?
  sortOrder     Int       @default(0)

  @@map("appraisal_goals")
}

// --- Traveler companion app -------------------------------------------------
// The client-facing PWA travellers install after paying. Auth is deliberately
// separate from the staff User/JWT stack: a traveller is not a User, has no
// password, and proves identity with a one-time code sent to the phone/email
// already on their Traveler record.

enum TripTransferType {
  ARRIVAL_PICKUP
  DEPARTURE_DROP
  INTERCITY
  DAY_TRANSFER
}

model TravelerOtp {
  id         String    @id @default(uuid())
  // Normalised phone (last 10 digits) or lowercased email — whichever the
  // traveller typed. Never store the code itself, only a SHA-256 hash, so a
  // database read cannot be replayed as a login.
  identifier String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, expiresAt])
  @@map("traveler_otps")
}

model TravelerSession {
  id         String    @id @default(uuid())
  // SHA-256 of the bearer token handed to the device. Same reasoning as the
  // OTP hash: a leaked DB dump must not yield usable sessions.
  tokenHash  String    @unique
  travelerId String
  traveler   Traveler  @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([travelerId])
  @@map("traveler_sessions")
}

model TripTransfer {
  id            String           @id @default(uuid())
  bookingId     String
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          TripTransferType
  scheduledAt   DateTime?
  fromLocation  String?
  toLocation    String?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  vehicleType   String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([bookingId])
  @@map("trip_transfers")
}

// Per-destination survival info the traveller app shows offline: local
// emergency numbers, vetted cab operators, Indian restaurants. Staff-managed
// so it can differ per country without a code change.
model CountryGuide {
  id               String   @id @default(uuid())
  country          String   @unique
  emergencyPolice  String?
  emergencyMedical String?
  embassyName      String?
  embassyPhone     String?
  embassyAddress   String?
  // [{ name, phone, notes? }]
  cabServices      Json?
  // [{ name, address?, phone?, cuisine? }]
  restaurants      Json?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("country_guides")
}

enum TravelerDocumentType {
  PASSPORT
  VISA
  FLIGHT_TICKET
  HOTEL_VOUCHER
  INSURANCE
  ID_PROOF
  OTHER
}

/// A file attached to a trip — a passport scan, a boarding pass, an insurance
/// certificate. Deliberately NOT stored under the public /uploads path: that
/// directory is served statically with no authentication, which is fine for an
/// itinerary photo and completely unacceptable for a passport. Files live in
/// private storage and are streamed only through an authenticated endpoint.
model TravelerDocument {
  id         String               @id @default(uuid())
  bookingId  String
  booking    Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Whose document this is. NULL means it belongs to the whole booking and
  /// every traveller on it can see it (a shared voucher, the group itinerary).
  /// Set means it is private to that one traveller — which is what keeps one
  /// family's passports invisible to the rest of a group tour.
  travelerId String?
  traveler   Traveler?            @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  type       TravelerDocumentType
  label      String
  /// Storage key, never a URL — there is no public address for this file.
  storageKey String
  mimeType   String
  sizeBytes  Int
  /// Set when a staff member uploaded it; null when the traveller did.
  uploadedById String?
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id])
  createdAt  DateTime             @default(now())

  @@index([bookingId])
  @@index([travelerId])
  @@map("traveler_documents")
}

enum FlightStatusCode {
  SCHEDULED
  ON_TIME
  DELAYED
  BOARDING
  DEPARTED
  LANDED
  CANCELLED
}

/// Live-ish status for a flight on a booking: delay, terminal, gate, belt.
///
/// Deliberately separate from the FLIGHT event on the itinerary. The itinerary
/// is the plan that was sold and shouldn't be rewritten because an aircraft is
/// forty minutes late; this is what is actually happening today, it changes
/// repeatedly, and every change notifies the traveller. Keeping them apart also
/// means one itinerary reused across bookings can't leak one group's gate to
/// another.
///
/// Filled by staff today. A flight-data API would populate exactly these same
/// columns later without anything downstream changing.
model TripFlight {
  id                 String           @id @default(uuid())
  bookingId          String
  booking            Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// The itinerary event this describes, so the app can attach the status to
  /// the right flight card. Null when the flight isn't on the plan.
  eventId            String?
  flightNumber       String
  fromAirport        String?
  toAirport          String?
  scheduledDeparture DateTime?
  /// Set only when it moves — the app shows the original struck through.
  revisedDeparture   DateTime?
  status             FlightStatusCode @default(SCHEDULED)
  terminal           String?
  gate               String?
  baggageBelt        String?
  /// Free text shown verbatim: "Inbound aircraft delayed, new time confirmed".
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([bookingId])
  @@map("trip_flights")
}
