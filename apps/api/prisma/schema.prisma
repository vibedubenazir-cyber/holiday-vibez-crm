// Holiday Vibez CRM — Phase 1 data model
// Mirrors spec Section 4 (Data Model - Core Entities) field-for-field.
// Entities beyond Phase 1's direct needs (Lead, Quotation, Booking, Payment, Target,
// Notification) are included now since they're relationally load-bearing for User/Branch
// and to avoid a schema-breaking migration in Phase 2, but only User/Branch/RateCard/
// Session/AuditLog have API+UI coverage in this pass.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  ADMIN
  BRANCH_MANAGER
  TRAVEL_CONSULTANT
  // Accounts/payments-scoped staff — full access to the Finance module (bookings,
  // payments, invoices, expenses, vendors, GST, petty cash, budgets, bank
  // reconciliation, DMC commissions) but no lead/quote edit rights and no access
  // to CRM/HRMS/LMS/Admin modules.
  FINANCE
  // Read-only cross-module access for external accountants/auditors — never
  // granted a write endpoint anywhere, enforced by only ever appearing on @Get().
  AUDITOR
}

enum UserStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum LeadSource {
  GOOGLE
  META // legacy value — superseded by INSTAGRAM/FACEBOOK below, kept for old rows
  WEBSITE
  WHATSAPP
  REFERRAL
  WALKIN
  INSTAGRAM
  FACEBOOK
  EXISTING_CUSTOMER
  AGENT_B2B
  PHONE_CALL
}

enum LeadStatus {
  NEW
  PROPOSAL_SENT
  NO_CONNECT
  HOT_LEAD
  PROPOSAL_CONFIRMED
  PLAN_DROPPED
  FOLLOW_UP
  CONFIRMED
  POSTPONED
  JUNK_NOT_INTERESTED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

// Applied at payment-creation time (see PaymentsService.create) rather than
// on the Quotation — a real checkout moment, not an estimate, so usedCount
// only increments once money is actually about to change hands.
model Coupon {
  id            String             @id @default(uuid())
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int?
  usedCount     Int                @default(0)
  active        Boolean            @default(true)
  createdBy     String
  createdAt     DateTime           @default(now())

  payments Payment[]

  @@map("coupons")
}

// Independent of LeadStatus (pipeline stage) — this is a consultant's own read
// on how likely/urgent the lead is to convert, shown as a colored badge (red/
// orange/green) in the UI. Defaults to WARM rather than forcing a judgment call
// at creation time.
enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RateCardType {
  ACTIVITY
  FLIGHT
  HOTEL
  TRANSFER
}

enum ClientType {
  INDIVIDUAL
  AGENT
  CORPORATE
  GROUP
}

enum RateCardSource {
  MANUAL
  API
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum PaymentType {
  CLIENT_RECEIPT
  DMC_PAYABLE
  COMMISSION
  REFUND
}

// Cost category for outbound payments (DMC_PAYABLE/COMMISSION/REFUND) — lets
// finance reports break "what we paid out" down by DMC/Flight/Hotel/Activity
// instead of one lump sum. Left null on CLIENT_RECEIPT rows (money in, no
// category applies).
enum PaymentCategory {
  DMC
  FLIGHT
  HOTEL
  ACTIVITY
  OTHER
}

enum TargetScope {
  BRANCH
  CONSULTANT
}

enum TargetPeriod {
  WEEK
  MONTH
  QUARTER
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum SupplierType {
  HOTEL
  FLIGHT
  ACTIVITY
  TRANSFER
  DMC
  OTHER
}

enum VoucherType {
  HOTEL
  FLIGHT
  TRANSFER
  COMBINED
}

enum InvoiceType {
  MANUAL
  FLIGHT
}

enum ExpenseCategory {
  OFFICE
  TRAVEL
  MARKETING
  SALARY
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TemplateStatus {
  DRAFT
  APPROVED
}

enum CmsContentType {
  BLOG
  BANNER
  TESTIMONIAL
  DESTINATION
  GALLERY
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  QUOTATION_SENT
  BOOKING_CONFIRMED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model User {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique
  phone            String
  passwordHash     String
  role             Role
  branchId         String?
  branch           Branch?    @relation("BranchUsers", fields: [branchId], references: [id])
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  // Browser's current FCM registration token, set via POST /notifications/push-token
  // once the user opts into push notifications on /security. Single most-recent
  // token per user — multi-device push is a natural follow-up, not built here.
  fcmToken         String?
  // Presence: lastSeenAt is bumped by a client heartbeat (see team-chat/presence);
  // computed status is ONLINE if recent, else OFFLINE, unless manualStatus overrides
  // it to BUSY. No separate "online" boolean — freshness of lastSeenAt is the signal.
  lastSeenAt       DateTime?
  manualStatus     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // HR profile fields — Employee Directory / Org Chart. All optional since
  // existing seeded/onboarded users won't have these set retroactively.
  designation           String?
  employeeCode          String?   @unique
  dateOfJoining         DateTime?
  profilePhotoUrl       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  reportsToId           String?
  reportsTo             User?     @relation("ReportsTo", fields: [reportsToId], references: [id])
  // Used by the Compliance Calendar to surface upcoming probation
  // confirmations — set alongside dateOfJoining, not auto-computed, since
  // probation length can vary per hire (contractor conversions, etc).
  probationEndDate      DateTime?

  managedBranch              Branch?                    @relation("BranchManager")
  assignedLeads              Lead[]                     @relation("AssignedConsultant")
  quotationsCreated          Quotation[]                @relation("QuotationConsultant")
  quotationsApproved         Quotation[]                @relation("QuotationApprover")
  sessions                   Session[]
  auditLogs                  AuditLog[]
  attendance                 Attendance[]
  messagesSent               Message[]
  leaveRequests              LeaveRequest[]             @relation("LeaveRequests")
  leaveReviews               LeaveRequest[]             @relation("LeaveReviews")
  salaryStructure            SalaryStructure?           @relation("SalaryStructure")
  payslips                   Payslip[]                  @relation("Payslips")
  assignedTickets            SupportTicket[]            @relation("AssignedTickets")
  teamChannelMemberships     TeamChannelMember[]
  teamMessagesSent           TeamMessage[]
  courseEnrollments          Enrollment[]
  directReports              User[]                     @relation("ReportsTo")
  exitRecord                 ExitRecord?
  performanceReviewsReceived PerformanceReview[]        @relation("RevieweeReviews")
  performanceReviewsGiven    PerformanceReview[]        @relation("ReviewerReviews")
  reimbursementClaims        ReimbursementClaim[]       @relation("ReimbursementClaimant")
  reimbursementReviews       ReimbursementClaim[]       @relation("ReimbursementReviewer")
  hrTicketsRaised            HrTicket[]                 @relation("HrTicketsRaised")
  hrTicketsAssigned          HrTicket[]                 @relation("HrTicketsAssigned")
  grievancesRaised           GrievanceReport[]          @relation("GrievancesRaised")
  grievancesHandled          GrievanceReport[]          @relation("GrievancesHandled")
  itineraryPlans             ItineraryPlan[]
  uploadedTravelerDocuments  TravelerDocument[]
  regularisationRequests     AttendanceRegularisation[] @relation("RegularisationRequests")
  regularisationReviews      AttendanceRegularisation[] @relation("RegularisationReviews")
  rosterEntries              RosterEntry[]              @relation("RosterEntries")
  employeeDocuments          EmployeeDocument[]         @relation("EmployeeDocuments")
  employeeDocumentsUploaded  EmployeeDocument[]         @relation("EmployeeDocumentsUploaded")
  onboardingTasks            OnboardingTask[]           @relation("OnboardingTasks")
  onboardingTasksCompleted   OnboardingTask[]           @relation("OnboardingTasksCompleted")
  assetsAssigned             Asset[]                    @relation("AssetsAssigned")
  appraisals                 Appraisal[]                @relation("Appraisals")
  appraisalsAsManager        Appraisal[]                @relation("AppraisalsAsManager")

  @@map("users")
}

// Key-value HR configuration — mirrors SiteSetting's shape exactly. Backs
// real behavior (LeaveService reads quota keys from here) rather than being
// a settings screen with knobs that don't do anything.
model HrSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("hr_settings")
}

enum HrTicketCategory {
  IT_ACCESS
  PAYROLL_QUERY
  BENEFITS
  WORKPLACE
  OTHER
}

// Internal employee helpdesk — distinct from SupportTicket, which is
// customer-facing (raised against a Lead). Mirrors its shape otherwise.
model HrTicket {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("HrTicketsRaised", fields: [userId], references: [id])
  category       HrTicketCategory
  subject        String
  description    String
  priority       TicketPriority   @default(MEDIUM)
  status         TicketStatus     @default(OPEN)
  assignedToId   String?
  assignedTo     User?            @relation("HrTicketsAssigned", fields: [assignedToId], references: [id])
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("hr_tickets")
}

enum GrievanceCategory {
  GENERAL_GRIEVANCE
  POSH_COMPLAINT
}

enum GrievanceStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
}

// Deliberately NOT branch-scoped like other HR modules — a POSH complaint
// may be about the employee's own branch manager, so visibility is
// Admin/Director only, never Branch Manager. See grievances.controller.ts.
model GrievanceReport {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("GrievancesRaised", fields: [userId], references: [id])
  category        GrievanceCategory
  description     String
  against         String?
  status          GrievanceStatus   @default(SUBMITTED)
  resolutionNotes String?
  handledById     String?
  handledBy       User?             @relation("GrievancesHandled", fields: [handledById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("hr_grievance_reports")
}

enum ExitType {
  RESIGNATION
  TERMINATION
}

enum ExitStatus {
  PENDING
  CLEARED
}

// Point-in-time record of one employee's offboarding — not a repeatable
// workflow, hence the 1:1 with User (a rehire after a prior exit would need
// a fresh User row, matching how the rest of this schema treats identity).
model ExitRecord {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id])
  type               ExitType
  noticeDate         DateTime
  lastWorkingDate    DateTime
  reason             String
  status             ExitStatus @default(PENDING)
  exitInterviewNotes String?
  clearedById        String?
  clearedAt          DateTime?
  createdAt          DateTime   @default(now())

  @@map("hr_exit_records")
}

enum PerformanceRating {
  NEEDS_IMPROVEMENT
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model PerformanceReview {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation("RevieweeReviews", fields: [userId], references: [id])
  reviewerId   String
  reviewer     User                    @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  period       String
  rating       PerformanceRating?
  strengths    String?
  improvements String?
  goals        String?
  status       PerformanceReviewStatus @default(DRAFT)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([userId, period])
  @@map("hr_performance_reviews")
}

enum ReimbursementCategory {
  TRAVEL
  CLIENT_ENTERTAINMENT
  SUPPLIES
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model ReimbursementClaim {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation("ReimbursementClaimant", fields: [userId], references: [id])
  category      ReimbursementCategory
  description   String
  amount        Decimal               @db.Decimal(14, 2)
  expenseDate   DateTime
  receiptUrl    String?
  status        ReimbursementStatus   @default(PENDING)
  reviewedById  String?
  reviewer      User?                 @relation("ReimbursementReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?
  paidAt        DateTime?
  createdAt     DateTime              @default(now())

  @@map("hr_reimbursement_claims")
}

model Branch {
  id              String   @id @default(uuid())
  name            String
  city            String
  managerId       String?  @unique
  manager         User?    @relation("BranchManager", fields: [managerId], references: [id])
  monthlyTarget   Decimal  @default(0) @db.Decimal(14, 2)
  quarterlyTarget Decimal  @default(0) @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]            @relation("BranchUsers")
  leads            Lead[]
  targets          Target[]
  expenses         Expense[]
  campaigns        Campaign[]
  teamChannels     TeamChannel[]
  pettyCashEntries PettyCashEntry[]
  budgets          Budget[]
  bankTransactions BankTransaction[]
  holidays         Holiday[]
  shifts           Shift[]
  assets           Asset[]

  @@map("branches")
}

model Lead {
  id                   String          @id @default(uuid())
  source               LeadSource
  utmCampaign          String?
  clientName           String
  phone                String
  email                String?
  destination          String
  branchId             String
  branch               Branch          @relation(fields: [branchId], references: [id])
  assignedConsultantId String?
  assignedConsultant   User?           @relation("AssignedConsultant", fields: [assignedConsultantId], references: [id])
  status               LeadStatus      @default(NEW)
  temperature          LeadTemperature @default(WARM)
  firstContactedAt     DateTime?
  slaBreached          Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Travel requirement intake fields — captured at lead creation, editable later.
  travelDate        DateTime? @db.Date
  adultsCount       Int?
  childrenCount     Int?
  childrenAges      String? // comma-separated ages, e.g. "5,8" — avoids a child sub-table for a display-only detail
  hotelCategory     Int? // star rating 1-5, matches Hotel.category
  mealPreference    String?
  transportRequired Boolean   @default(false)
  visaRequired      Boolean   @default(false)
  flightRequired    Boolean   @default(false)
  insuranceRequired Boolean   @default(false)

  // Optional link to a Client business-entity record (agent/corporate/group
  // account). clientName stays the free-text field it always was — this is
  // opt-in, not a replacement, so existing leads need no backfill.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  travelers      Traveler[]
  quotations     Quotation[]
  conversations  Conversation[]
  automationLogs AutomationLog[]
  supportTickets SupportTicket[]
  itineraryPlans ItineraryPlan[]

  @@map("leads")
}

model Client {
  id            String     @id @default(uuid())
  name          String
  type          ClientType @default(INDIVIDUAL)
  phone         String?
  email         String?
  gstNumber     String? // corporate accounts
  commissionPct Decimal?   @db.Decimal(5, 2) // agent accounts
  notes         String?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())

  leads          Lead[]
  loyaltyAccount LoyaltyAccount?

  @@map("clients")
}

enum LoyaltyTxnType {
  EARNED
  REDEEMED
  REFERRAL_BONUS
  ADJUSTMENT
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id])
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String         @id @default(uuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id])
  type        LoyaltyTxnType
  points      Int
  bookingId   String?
  description String?
  createdBy   String
  createdAt   DateTime       @default(now())

  @@map("loyalty_transactions")
}

model Traveler {
  id                String    @id @default(uuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id])
  name              String
  phone             String?
  email             String?
  passportNumberEnc String? // field-level AES-encrypted at the application layer, never stored in plaintext
  passportExpiry    DateTime?
  visaStatus        String?
  insurancePolicyNo String?
  dateOfBirth       DateTime? @db.Date
  anniversaryDate   DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appSessions TravelerSession[]
  documents   TravelerDocument[]

  @@map("travelers")
}

model RateCard {
  id          String         @id @default(uuid())
  type        RateCardType
  destination String
  name        String
  baseCost    Decimal        @db.Decimal(14, 2)
  taxPct      Decimal        @default(0) @db.Decimal(5, 2)
  currency    String         @default("INR")
  source      RateCardSource @default(MANUAL)
  createdBy   String
  version     Int            @default(1)
  active      Boolean        @default(true)
  supplierId  String?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  quotationItems QuotationItem[]
  packageItems   PackageItem[]

  @@map("rate_cards")
}

model Supplier {
  id           String       @id @default(uuid())
  name         String
  type         SupplierType
  contactName  String?
  phone        String?
  email        String?
  destination  String?
  gstin        String?
  address      String?
  paymentTerms String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  rateCards      RateCard[]
  payments       Payment[]
  dmcCommissions DmcCommission[]

  @@map("suppliers")
}

model Package {
  id            String   @id @default(uuid())
  name          String
  destination   String
  theme         String?
  durationDays  Int
  basePrice     Decimal  @default(0) @db.Decimal(14, 2)
  currency      String   @default("INR")
  coverImageUrl String?
  active        Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PackageItem[]

  @@map("packages")
}

model PackageItem {
  id          String   @id @default(uuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id])
  rateCardId  String
  rateCard    RateCard @relation(fields: [rateCardId], references: [id])
  dayNumber   Int
  description String
  quantity    Int      @default(1)

  @@map("package_items")
}

model Quotation {
  id           String          @id @default(uuid())
  refNo        String          @unique
  version      Int             @default(1)
  leadId       String
  lead         Lead            @relation(fields: [leadId], references: [id])
  consultantId String
  consultant   User            @relation("QuotationConsultant", fields: [consultantId], references: [id])
  status       QuotationStatus @default(DRAFT)
  approvedById String?
  approvedBy   User?           @relation("QuotationApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  totalAmount  Decimal         @default(0) @db.Decimal(14, 2)
  currency     String          @default("INR")
  pdfUrl       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items     QuotationItem[]
  bookings  Booking[]
  itinerary Itinerary?

  @@map("quotations")
}

enum RoomCategory {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  CWB // Child With Bed
  CNB // Child No Bed
}

enum TransportationType {
  PRIVATE
  SIC // Seat-in-Coach
}

// Simple day-note categories the spec lists alongside Accommodation/Activity/
// Transportation without their own detailed sub-fields — a description each.
enum ItineraryNoteType {
  VISA
  MEAL
  FLIGHT
  LEISURE
  CRUISE
}

// Day-wise itinerary document attached to a Quotation, distinct from
// QuotationItem (which drives pricing) — this is the customer-facing
// "what happens each day" narrative plus static terms sections.
model Itinerary {
  id                       String    @id @default(uuid())
  quotationId              String    @unique
  quotation                Quotation @relation(fields: [quotationId], references: [id])
  bookingPaymentTerms      String?
  pricingTerms             String?
  inclusionsExclusions     String?
  cancellationRefundPolicy String?
  importantInstructions    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  days ItineraryDay[]

  @@map("itineraries")
}

model ItineraryDay {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  date        DateTime? @db.Date
  title       String?

  accommodations  ItineraryAccommodation[]
  activities      ItineraryActivity[]
  transportations ItineraryTransportation[]
  notes           ItineraryNote[]

  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

model ItineraryAccommodation {
  id            String       @id @default(uuid())
  dayId         String
  day           ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  hotelName     String
  city          String
  checkInDate   DateTime     @db.Date
  checkOutDate  DateTime     @db.Date
  nights        Int
  roomCategory  RoomCategory
  numberOfRooms Int
  checkInTime   String?
  checkOutTime  String?
  description   String?

  @@map("itinerary_accommodations")
}

model ItineraryActivity {
  id           String       @id @default(uuid())
  dayId        String
  day          ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  destination  String
  activityName String
  description  String?

  @@map("itinerary_activities")
}

model ItineraryTransportation {
  id          String             @id @default(uuid())
  dayId       String
  day         ItineraryDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  type        TransportationType
  description String?

  @@map("itinerary_transportations")
}

model ItineraryNote {
  id          String            @id @default(uuid())
  dayId       String
  day         ItineraryDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  type        ItineraryNoteType
  description String?

  @@map("itinerary_notes")
}

// --- Standalone Itinerary module ("ItineraryPlan*") ---------------------
// Distinct from `Itinerary` above (which is nested 1:1 under a Quotation)
// and from `DayItinerary` (a flat content-library master). This is a
// standalone, optionally lead-linked itinerary with 8 event types,
// multiple priced accommodation options, package terms, an image
// gallery, and a public shareable client report.

enum ItineraryPlanStatus {
  DRAFT
  READY_TO_SHARE
  ARCHIVED
}

enum ItineraryEventType {
  ACCOMMODATION
  ACTIVITY
  TRANSPORTATION
  VISA
  MEAL
  FLIGHT
  LEISURE
  CRUISE
}

model ItineraryPlan {
  id                    String              @id @default(uuid())
  refNo                 String              @unique
  title                 String
  leadId                String?
  lead                  Lead?               @relation(fields: [leadId], references: [id])
  destinations          String[]
  startDate             DateTime?           @db.Date
  endDate               DateTime?           @db.Date
  adultsCount           Int                 @default(1)
  childrenCount         Int                 @default(0)
  infantsCount          Int                 @default(0)
  notes                 String?
  coverPhotoUrl         String?
  theme                 String?
  // IANA zone of the destination (e.g. "Asia/Bangkok"). Hotel and flight times
  // are stored as wall-clock strings that are already destination-local, but
  // TripTransfer.scheduledAt is a real instant — without this the traveller app
  // renders a Bangkok pickup in whatever timezone their phone is currently in.
  timezone              String?
  status                ItineraryPlanStatus @default(DRAFT)
  showOnWebsite         Boolean             @default(false)
  websitePerPersonPrice Decimal?            @db.Decimal(14, 2)
  websiteValidUntil     DateTime?           @db.Date
  isPopular             Boolean             @default(false)
  isSpecial             Boolean             @default(false)
  aboutPackage          String?
  createdById           String
  createdBy             User                @relation(fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  days           ItineraryPlanDay[]
  pricingOptions ItineraryPricingOption[]
  images         ItineraryImage[]
  packageTerms   ItineraryPackageTerms?

  @@map("itinerary_plans")
}

model ItineraryPlanDay {
  id              String               @id @default(uuid())
