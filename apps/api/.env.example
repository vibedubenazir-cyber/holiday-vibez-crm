DATABASE_URL="postgresql://holidayvibez:holidayvibez@localhost:5432/holiday_vibez_crm"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
REFRESH_SECRET="change-me-in-production"
PUBLIC_LEAD_API_KEY=""
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV=development

# --- WhatsApp / Email / Push ---
# WhatsApp, Email, and Push are all fully wired
# (apps/api/src/notifications/notifications.service.ts +
# apps/api/src/inbox/whatsapp-webhook.controller.ts for WhatsApp's inbound side) —
# set the vars below and they send/receive for real; leave them unset and it falls
# back to a console-log + Notification row.
WHATSAPP_API_KEY=""              # Meta WhatsApp Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=""      # Meta WhatsApp Cloud API phone number ID
WHATSAPP_APP_SECRET=""           # Meta App secret — verifies the webhook's X-Hub-Signature-256 header
WHATSAPP_WEBHOOK_VERIFY_TOKEN="" # Arbitrary string you choose; enter the same value in Meta's webhook setup
EMAIL_PROVIDER_KEY=""            # SendGrid API key (Settings > API Keys in your SendGrid account)
EMAIL_FROM_ADDRESS=""            # Sender address verified in SendGrid (Settings > Sender Authentication)
# Firebase Cloud Messaging — HTTP v1 API only (the old single-key Legacy HTTP API
# was shut down by Google in mid-2024). All three values come from the JSON file
# downloaded at Firebase Console > Project Settings > Service Accounts > Generate
# new private key. FCM_PRIVATE_KEY: paste with literal \n for newlines (the code
# unescapes them) — that's how the downloaded JSON already has it if copied as one line.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Payment gateway (Razorpay) ---
# Fully wired: apps/api/src/payments/payments.service.ts's createPaymentLink()
# generates a real hosted-checkout link via Razorpay's Payment Links API;
# apps/api/src/payments/razorpay-webhook.controller.ts confirms it paid. The
# existing manual "Mark paid" button (offline/cash reconciliation) is unaffected
# either way.
PAYMENT_GATEWAY_KEY=""           # Razorpay key_secret (Settings > API Keys)
PAYMENT_GATEWAY_KEY_ID=""        # Razorpay key_id (Settings > API Keys)
PAYMENT_GATEWAY_WEBHOOK_SECRET=""# Webhook secret you set when registering the webhook URL in Razorpay's dashboard

# --- Hotel / Flight / Transfer live search ---
# Consumed by apps/api/src/travel-search/{hotel,flight,transfer}-search.service.ts,
# which currently return deterministic mock results instead of calling a real supplier.
HOTEL_SUPPLIER_API_KEY=""        # GDS/hotel-aggregator API key
FLIGHT_SUPPLIER_API_KEY=""       # GDS/flight-aggregator API key
TRANSFER_SUPPLIER_API_KEY=""     # transfer/cab-aggregator API key

# --- Forex rates ---
# Fully wired: apps/api/src/currency/currency.service.ts's refreshRates() pulls
# real rates from exchangerate-api.com when this is set; falls back to a small
# random drift (demonstrates the "scheduled updates" behavior without a key)
# otherwise. Get a free-tier key at https://www.exchangerate-api.com/.
FOREX_API_KEY=""

# --- AI / LLM (Anthropic Claude) ---
# Fully wired: apps/api/src/inbox/inbox.service.ts's generateBotReply() calls
# Anthropic's Messages API (apps/api/src/inbox/llm.util.ts) with the last 10
# messages of conversation history for context when this is set; falls back to
# keyword matching (or a real-call failure) otherwise. Get a key at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=""

# --- Object storage (AWS S3) ---
# Fully wired: apps/api/src/storage/storage.controller.ts uploads real files to
# an S3 bucket via the official @aws-sdk/client-s3 (apps/api/src/storage/s3.util.ts)
# when all four vars below are set; falls back to writing to local disk
# (apps/api/uploads/) otherwise. The bucket needs public-read (or a CloudFront/
# CDN in front of it) since uploaded URLs are handed straight to <img>/<a> tags —
# no signed-URL support today.
OBJECT_STORAGE_KEY=""             # secret access key
OBJECT_STORAGE_ACCESS_KEY_ID=""   # access key id
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION=""          # e.g. ap-south-1 for AWS; "auto" for a Railway Bucket
OBJECT_STORAGE_ENDPOINT=""        # only for non-AWS S3-compatible providers, e.g. a Railway Bucket's endpoint (https://xxx.storageapi.dev). Leave unset for real AWS S3.

# Live flight data (aviationstack or compatible). Leave unset until purchased —
# flight status stays staff-entered and the 30-minute poll no-ops.
FLIGHT_API_KEY=""
# Optional override; defaults to https://api.aviationstack.com/v1
FLIGHT_API_BASE=""
