DATABASE_URL="postgresql://holidayvibez:holidayvibez@localhost:5432/holiday_vibez_crm"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
REFRESH_SECRET="change-me-in-production"
PUBLIC_LEAD_API_KEY=""
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV=development

# --- WhatsApp / Email / Push ---
# WhatsApp and Email are both fully wired
# (apps/api/src/notifications/notifications.service.ts +
# apps/api/src/inbox/whatsapp-webhook.controller.ts for WhatsApp's inbound side) —
# set the vars below and they send/receive for real; leave them unset and it falls
# back to a console-log + Notification row, same as push (not yet wired).
WHATSAPP_API_KEY=""              # Meta WhatsApp Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=""      # Meta WhatsApp Cloud API phone number ID
WHATSAPP_APP_SECRET=""           # Meta App secret — verifies the webhook's X-Hub-Signature-256 header
WHATSAPP_WEBHOOK_VERIFY_TOKEN="" # Arbitrary string you choose; enter the same value in Meta's webhook setup
EMAIL_PROVIDER_KEY=""            # SendGrid API key (Settings > API Keys in your SendGrid account)
EMAIL_FROM_ADDRESS=""            # Sender address verified in SendGrid (Settings > Sender Authentication)
FCM_SERVER_KEY=""                # Firebase Cloud Messaging server key, for push notifications

# --- Payment gateway ---
# Consumed by apps/api/src/payments/payments.service.ts's markPaid(), which currently
# mocks a hosted-checkout confirmation instead of calling a real gateway.
PAYMENT_GATEWAY_KEY=""           # e.g. Razorpay/Stripe secret key
PAYMENT_GATEWAY_KEY_ID=""        # e.g. Razorpay key id (public) — only needed if the provider uses an id+secret pair

# --- Hotel / Flight / Transfer live search ---
# Consumed by apps/api/src/travel-search/{hotel,flight,transfer}-search.service.ts,
# which currently return deterministic mock results instead of calling a real supplier.
HOTEL_SUPPLIER_API_KEY=""        # GDS/hotel-aggregator API key
FLIGHT_SUPPLIER_API_KEY=""       # GDS/flight-aggregator API key
TRANSFER_SUPPLIER_API_KEY=""     # transfer/cab-aggregator API key

# --- Forex rates ---
# Consumed by apps/api/src/currency/currency.service.ts's refreshRates(), which
# currently nudges API-sourced rates by a small random drift instead of pulling live rates.
FOREX_API_KEY=""                 # e.g. exchangerate-api.com or openexchangerates.org key

# --- AI / LLM ---
# Consumed by apps/api/src/inbox/inbox.service.ts's bot-reply lookup, which currently
# does keyword matching instead of calling a real model.
LLM_API_KEY=""                   # Anthropic/OpenAI API key

# --- Object storage ---
# Consumed by apps/api/src/storage/storage.controller.ts, which currently writes
# uploads to local disk (apps/api/uploads/) instead of a real object store.
OBJECT_STORAGE_KEY=""            # e.g. AWS S3 secret access key
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION=""
