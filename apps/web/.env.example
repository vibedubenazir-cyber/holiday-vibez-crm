NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Push notifications (apps/web/src/lib/push.ts) — from Firebase Console >
# Project Settings > General (app config) and > Cloud Messaging (Web Push
# certificate / VAPID key). Leave unset and the Push Notifications section on
# /security shows "not configured" instead of erroring.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
